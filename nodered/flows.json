    {
        "id": "c_fn",
        "type": "function",
        "z": "tab_garaje_corto",
        "name": "Validar estado",
        "func": "const estado = msg.payload.estado;\n\nif (estado !== \"ABIERTA\" && estado !== \"CERRADA\") {\n    msg.statusCode = 400;\n    msg.payload = { error: \"estado no valido\" };\n    return [null, msg];   // salida 2: error\n}\n\nmsg.params = [estado];\nreturn [msg, null];       // salida 1: guardar",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 100,
        "wires": [
            [
                "c_pg"
            ],
            [
                "c_resp"
            ]
        ]
    },
    {
        "id": "c_pg",
        "type": "postgresql",
        "z": "tab_garaje_corto",
        "name": "Guardar evento",
        "query": "INSERT INTO eventos (estado) VALUES ($1);",
        "postgreSQLConfig": "pg_config",
        "split": false,
        "rowsPerMsg": 1,
