[
    {
        "id": "tab_garaje_dash",
        "type": "tab",
        "label": "Alarma Garaje",
        "disabled": false,
        "info": "ESP32 -> Node-RED -> PostgreSQL + Dashboard"
    },
    {
        "id": "d_in",
        "type": "http in",
        "z": "tab_garaje_dash",
        "name": "POST /puerta",
        "url": "/puerta",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 130,
        "y": 100,
        "wires": [
            [
                "d_fn"
            ]
        ]
    },
    {
        "id": "d_fn",
        "type": "function",
        "z": "tab_garaje_dash",
        "name": "Validar y preparar",
        "func": "const estado = msg.payload.estado;\n\n// 1) Sanitizar: solo se aceptan dos estados\nif (estado !== \"ABIERTA\" && estado !== \"CERRADA\") {\n    msg.statusCode = 400;\n    return [null, null, msg];        // salida 3: error\n}\n\n// 2) Convertir a numero: 1 = abierta, 0 = cerrada\nconst valor = (estado === \"ABIERTA\") ? 1 : 0;\n\n// 3) Recordar desde cuando esta abierta (para el umbral)\nflow.set(\"abiertaDesde\", valor ? Date.now() : null);\n\nmsg.params = [\"puerta\", valor];    // parametros del INSERT\nreturn [msg, { payload: valor }, null];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 100,
        "wires": [
            [
                "d_pg"
            ],
            [
                "d_chart"
            ],
            [
                "d_resp"
            ]
        ]
    },
    {
        "id": "d_pg",
        "type": "postgresql",
        "z": "tab_garaje_dash",
        "name": "Guardar lectura",
        "query": "INSERT INTO telemetria (sensor, valor) VALUES ($1, $2);",
        "postgreSQLConfig": "pg_config",
        "split": false,
        "rowsPerMsg": 1,
        "outputs": 1,
        "x": 620,
        "y": 60,
        "wires": [
            [
                "d_resp"
            ]
        ]
    },
    {
        "id": "d_resp",
        "type": "http response",
        "z": "tab_garaje_dash",
        "name": "Responder",
        "statusCode": "",
        "headers": {},
        "x": 860,
        "y": 60,
        "wires": []
    },
