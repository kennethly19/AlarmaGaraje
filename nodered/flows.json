    {
        "id": "d_umbral",
        "type": "function",
        "z": "tab_garaje_dash",
        "name": "Tiempo abierta y umbral",
        "func": "const UMBRAL = 30;   // segundos (umbral critico)\n\nconst desde = flow.get(\"abiertaDesde\");\nconst seg = desde ? Math.floor((Date.now() - desde) / 1000) : 0;\n\nconst alerta = (seg > UMBRAL)\n    ? \"ALERTA: puerta abierta hace \" + seg + \" s\"\n    : \"Sin alertas\";\n\nreturn [{ payload: seg }, { payload: alerta }];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 240,
        "wires": [
            [
                "d_gauge"
            ],
            [
                "d_texto"
            ]
        ]
    },
